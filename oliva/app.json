{
  "expo": {
    "name": "OLIVA",
    "slug": "oliva-faith-companion",
    "version": "0.7.0",
    "scheme": "oliva",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.oliva.companion"
    },
    "android": {
      "package": "app.oliva.companion"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "OLIVA \u00b7 Raum f\u00fcr deinen Glauben",
      "themeColor": "#314c3b"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
