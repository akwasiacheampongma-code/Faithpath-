
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const uid=()=>crypto.randomUUID?crypto.randomUUID():"id"+Date.now()+Math.random();
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
const fmt=d=>new Date(d).toLocaleDateString("de-DE",{day:"numeric",month:"short",year:"numeric"});
const versePair=(v,i)=>Array.isArray(v)?[Number(v[0]),Array.isArray(v[1])?v[1].join(""):String(v[1]??"")]:[i+1,String(v??"")];
const KEY="faithpath.v1.rebuild";
const stageNames=["Samen","Keimling","Junger Olivenbaum","Wachsender Olivenbaum","Starker Olivenbaum","Erste Früchte","Fruchttragender Olivenbaum"];
let books=[],stories=[],bookCache={};
const TRANSLATIONS={otb:{label:"OTB",name:"Open Translation Bible Deutsch"},l1912:{label:"Luther 1912",name:"Lutherbibel 1912"}};
const BOOK_ALIASES={mar:"MRK",joh:"JHN",jak:"JAS",pro:"PRO",php:"PHP",mat:"MAT",psa:"PSA",rom:"ROM",eph:"EPH",col:"COL",heb:"HEB",rev:"REV",luk:"LUK",act:"ACT","1th":"1TH","1pe":"1PE",gal:"GAL","1jn":"1JN","2jn":"2JN","3jn":"3JN","2pe":"2PE","2th":"2TH","1ti":"1TI","2ti":"2TI",phm:"PHM",tit:"TIT",jud:"JUD",jas:"JAS",mrk:"MRK",jhn:"JHN"};
function normBook(code){let raw=String(code||"");return BOOK_ALIASES[raw.toLowerCase()]||raw.toUpperCase()}

const fresh=()=>({version:4,translation:"otb",paths:[],journal:[],highlights:[],reflections:[],quiz:{},events:[],reading:null,reminderSnoozes:{},dismissedGaps:{}});
const SAFE_ID=/^[A-Za-z0-9._:-]{1,120}$/;
const SAFE_BOOK=/^[1-3]?[A-Z]{2,3}$/;
const REVIEW_STATUSES=new Set(["changed","working","notnow","thought","later"]);
function asArray(v,name,strict=false){if(v==null)return [];if(Array.isArray(v))return v;if(strict)throw new Error("invalid "+name);return []}
function cleanText(v,name,strict=false,max=20000,fallback=""){if(v==null)return fallback;if(typeof v!=="string"){if(strict)throw new Error("invalid "+name);v=String(v)}if(v.length>max){if(strict)throw new Error("too long "+name);v=v.slice(0,max)}return v}
function safeDate(v,name,strict=false,fallback=null){if(v==null||v==="")return fallback;let t=new Date(v).getTime();if(!Number.isFinite(t)){if(strict)throw new Error("invalid "+name);return fallback}return new Date(t).toISOString()}
function safeId(v,name,strict=false,used=null,required=true){let x=v==null?"":String(v);if(!x||!SAFE_ID.test(x)||(used&&used.has(x))){if(strict&&required)throw new Error("invalid or duplicate "+name);do{x=uid()}while(used&&used.has(x))}if(used)used.add(x);return x||null}
function safeBook(code,strict=false){let b=normBook(code);if(!SAFE_BOOK.test(b)){if(strict)throw new Error("invalid book");return null}return b}
function normalizeRef(ref,strict=false){if(!ref||typeof ref!=="object"){if(strict&&ref!=null)throw new Error("invalid ref");return null}let book=safeBook(ref.book,strict);if(!book)return null;let chapter=Number(ref.chapter),from=ref.from==null?null:Number(ref.from),to=ref.to==null?null:Number(ref.to);if(from==null&&to!=null)from=to;if(from!=null&&to==null)to=from;if(!Number.isInteger(chapter)||chapter<1||chapter>200||(from!=null&&(!Number.isInteger(from)||from<1||from>999))||(to!=null&&(!Number.isInteger(to)||to<1||to>999))||(from!=null&&to!=null&&to<from)){if(strict)throw new Error("invalid ref range");return null}return {book,chapter,from,to,label:cleanText(ref.label,"ref label",strict,300,""),translation:TRANSLATIONS[ref.translation]?ref.translation:"otb"}}
function normalizeStep(x,strict=false){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid step");return null}let text=cleanText(x.text,"step text",strict,1000,"").trim();if(!text){if(strict)throw new Error("empty step");return null}return {text,done:!!x.done,suggested:!!x.suggested}}
function normalizeReview(x,strict=false,used=null){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid review");return null}let text=cleanText(x.text,"review text",strict,10000,"").trim();if(!text){if(strict)throw new Error("empty review");return null}return {id:safeId(x.id,"review id",strict,used,false),date:safeDate(x.date,"review date",strict,new Date().toISOString()),text,status:REVIEW_STATUSES.has(x.status)?x.status:"thought",confirmedDevelopment:!!x.confirmedDevelopment}}
function normalizeMilestone(x,strict=false,used=null){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid milestone");return null}let text=cleanText(x.text,"milestone text",strict,10000,"").trim();if(!text){if(strict)throw new Error("empty milestone");return null}return {id:safeId(x.id,"milestone id",strict,used,false),date:safeDate(x.date,"milestone date",strict,new Date().toISOString()),text,reviewId:x.reviewId&&SAFE_ID.test(String(x.reviewId))?String(x.reviewId):null}}
function normalizeLink(link,strict=false,used=null){if(!link||typeof link!=="object"){if(strict)throw new Error("invalid link");return null}let ref=normalizeRef(link.ref,false)||(link.book&&link.chapter?normalizeRef({book:link.book,chapter:link.chapter,from:link.from,to:link.to,label:link.label,translation:link.translation},false):null),kind=["verse","reflection","link"].includes(link.kind||link.type)?(link.kind||link.type):(ref?"verse":"link");return {id:safeId(link.id,"link id",strict,used,false),kind,date:safeDate(link.date,"link date",strict,new Date().toISOString()),label:cleanText(link.label||ref?.label||"Bibelstelle","link label",strict,500,"Bibelstelle"),storyId:Number.isInteger(Number(link.storyId))?Number(link.storyId):null,reflectionId:link.reflectionId&&SAFE_ID.test(String(link.reflectionId))?String(link.reflectionId):null,ref}}
function normalizePath(path,strict=false,used=null){if(!path||typeof path!=="object"){if(strict)throw new Error("invalid path");return null}let title=cleanText(path.title,"path title",strict,500,"").trim();if(!title){if(strict)throw new Error("empty path title");title="Unbenannter Weg"}let started=safeDate(path.started,"path started",strict,new Date().toISOString()),reviewIds=new Set(),milestoneIds=new Set(),linkIds=new Set(),steps=asArray(path.steps,"steps",strict).map(x=>normalizeStep(x,strict)).filter(Boolean),reviews=asArray(path.reviews,"reviews",strict).map(x=>normalizeReview(x,strict,reviewIds)).filter(Boolean),milestones=asArray(path.milestones,"milestones",strict).map(x=>normalizeMilestone(x,strict,milestoneIds)).filter(Boolean),links=asArray(path.links,"links",strict).map(x=>normalizeLink(x,strict,linkIds)).filter(Boolean),lastReview=safeDate(path.lastReview,"last review",strict,null);if(lastReview&&!reviews.length&&Math.abs(new Date(lastReview)-new Date(started))<5000)lastReview=null;if(!lastReview&&reviews.length)lastReview=reviews.map(r=>r.date).sort().at(-1);return {id:safeId(path.id,"path id",strict,used,false),title,why:cleanText(path.why,"path why",strict,10000,""),category:cleanText(path.category,"path category",strict,100,"sonstiges")||"sonstiges",started,lastReview,steps,milestones,reviews,links,archived:!!path.archived}}
function normalizeJournal(x,strict=false,used=null){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid journal");return null}let text=cleanText(x.text,"journal text",strict,20000,"").trim();if(!text){if(strict)throw new Error("empty journal");return null}return {id:safeId(x.id,"journal id",strict,used,false),type:cleanText(x.type,"journal type",strict,100,"Journal")||"Journal",subtype:cleanText(x.subtype,"journal subtype",strict,100,""),text,date:safeDate(x.date,"journal date",strict,new Date().toISOString()),storyId:Number.isInteger(Number(x.storyId))?Number(x.storyId):null,ref:normalizeRef(x.ref,false)}}
function normalizeHighlight(x,strict=false,used=null){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid highlight");return null}let ref=normalizeRef({book:x.book,chapter:x.chapter,from:x.from,to:x.to,label:x.label,translation:x.translation},strict);if(!ref)return null;return {id:safeId(x.id,"highlight id",strict,used,false),book:ref.book,chapter:ref.chapter,from:ref.from,to:ref.to,label:cleanText(x.label||ref.label,"highlight label",strict,500,"Bibelstelle"),snippet:cleanText(x.snippet,"highlight snippet",strict,2000,""),translation:ref.translation,at:safeDate(x.at,"highlight date",strict,new Date().toISOString())}}
function normalizeReflection(x,strict=false,used=null){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid reflection");return null}let text=cleanText(x.text,"reflection text",strict,20000,"").trim();if(!text){if(strict)throw new Error("empty reflection");return null}return {id:safeId(x.id,"reflection id",strict,used,false),storyId:Number.isInteger(Number(x.storyId))?Number(x.storyId):null,text,date:safeDate(x.date,"reflection date",strict,new Date().toISOString()),label:cleanText(x.label,"reflection label",strict,500,"Reflexion"),highlightId:x.highlightId&&SAFE_ID.test(String(x.highlightId))?String(x.highlightId):null,ref:normalizeRef(x.ref,false)}}
function normalizeEvent(x,strict=false,used=null){if(!x||typeof x!=="object"){if(strict)throw new Error("invalid event");return null}return {id:safeId(x.id,"event id",strict,used,false),at:safeDate(x.at,"event date",strict,new Date().toISOString()),text:cleanText(x.text,"event text",strict,10000,""),pathId:x.pathId&&SAFE_ID.test(String(x.pathId))?String(x.pathId):null}}
function normalizeDateMap(raw,prefix,validIds,strict=false){if(raw==null)return {};if(typeof raw!=="object"||Array.isArray(raw)){if(strict)throw new Error("invalid reminder map");return {}}let out={};for(const [k,v] of Object.entries(raw)){if(!k.startsWith(prefix))continue;let id=k.slice(prefix.length);if(!validIds.has(id))continue;let d=safeDate(v,"reminder date",strict,null);if(d)out[k]=d}return out}
function normalizeState(data,strict=false){if(!data||typeof data!=="object"||Array.isArray(data)){if(strict)throw new Error("invalid data");return fresh()}if(strict&&(!Array.isArray(data.paths)||!Array.isArray(data.journal)||!Array.isArray(data.highlights)))throw new Error("invalid root arrays");let pathIds=new Set(),journalIds=new Set(),highlightIds=new Set(),reflectionIds=new Set(),eventIds=new Set(),paths=asArray(data.paths,"paths",strict).map(x=>normalizePath(x,strict,pathIds)).filter(Boolean),journal=asArray(data.journal,"journal",strict).map(x=>normalizeJournal(x,strict,journalIds)).filter(Boolean),highlights=asArray(data.highlights,"highlights",strict).map(x=>normalizeHighlight(x,strict,highlightIds)).filter(Boolean),reflections=asArray(data.reflections,"reflections",strict).map(x=>normalizeReflection(x,strict,reflectionIds)).filter(Boolean),events=asArray(data.events,"events",strict).map(x=>normalizeEvent(x,strict,eventIds)).filter(Boolean);if(strict){for(const p of paths)for(const l of p.links)if(l.kind==="reflection"&&l.reflectionId&&!reflectionIds.has(l.reflectionId))throw new Error("missing reflection link")}let quiz={};if(data.quiz&&typeof data.quiz==="object"&&!Array.isArray(data.quiz))for(const [k,v] of Object.entries(data.quiz))if(/^\d+$/.test(k)&&v&&typeof v==="object"){let done=safeDate(v.done,"quiz date",strict,null);if(done)quiz[k]={done}}let reading=null;if(data.reading&&typeof data.reading==="object"){let book=safeBook(data.reading.book,strict),chapter=Number(data.reading.chapter);if(book&&Number.isInteger(chapter)&&chapter>0&&chapter<=200)reading={book,chapter}}let validReminderIds=new Set([...pathIds,...highlightIds]),snoozes={...normalizeDateMap(data.reminderSnoozes,"path:",pathIds,strict),...normalizeDateMap(data.reminderSnoozes,"highlight:",highlightIds,strict)},dismissed={...normalizeDateMap(data.dismissedGaps,"path:",pathIds,strict),...normalizeDateMap(data.dismissedGaps,"highlight:",highlightIds,strict)};return {version:4,translation:TRANSLATIONS[data.translation]?data.translation:"otb",paths,journal,highlights,reflections,quiz,events,reading,reminderSnoozes:snoozes,dismissedGaps:dismissed}}
function load(){try{return normalizeState(JSON.parse(localStorage.getItem(KEY)||"{}"))}catch{return fresh()}}
let S=load();localStorage.setItem(KEY,JSON.stringify(S));let UI={tab:"today",bibleTab:"stories",book:null,chapter:1,selected:new Set(),story:null,qi:0,answered:null,path:null,journalFilter:"Alle",historyLimit:120,readerBack:null,readerTranslation:null,pending:null,connectPendingOnCreate:false};
const save=()=>localStorage.setItem(KEY,JSON.stringify(S));
function log(text,extra={}){S.events.unshift({id:uid(),at:new Date().toISOString(),text,...extra});S.events=S.events.slice(0,300);save()}
function toast(t){let e=$("#toast");e.textContent=t;e.classList.add("on");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove("on"),1800)}
async function init(){[books,stories]=await Promise.all([fetch("data/index.json").then(r=>r.json()),fetch("data/stories.json").then(r=>r.json())]);go("today")}
function shell(body){return `<div class="top"><div class="brand">FaithPath</div><button class="round" onclick="go('more')">•••</button></div>${body}${nav()}`}
function nav(){let a=[["today","⌂","Heute"],["bible","☰","Bibel"],["paths","⌁","Mein Weg"],["journal","✎","Journal"],["more","⋯","Mehr"]];return `<nav class="nav">${a.map(x=>`<button class="${UI.tab===x[0]?"on":""}" onclick="go('${x[0]}')"><span>${x[1]}</span>${x[2]}</button>`).join("")}</nav>`}
function go(tab){UI.tab=tab;UI.selected.clear();UI.readerBack=null;UI.readerTranslation=null;if(tab==="today")renderToday();if(tab==="bible")renderBible();if(tab==="paths")renderPaths();if(tab==="journal")renderJournal();if(tab==="more")renderMore()}
function treeLevel(){let m=S.paths.reduce((n,p)=>n+(p.milestones?.length||0),0);if(m===0)return 0;if(m===1)return 1;if(m===2)return 2;if(m<=4)return 3;if(m<=6)return 4;if(m<=9)return 5;return 6}

