 {id:"versuchung",icon:"↗",title:"Versuchung",sub:"Wenn du mit einem wiederkehrenden Muster ringst",category:"disziplin",refs:[{book:"1CO",chapter:10,from:12,to:13,label:"1. Korinther 10,12–13",context:"Der Text warnt vor Selbstsicherheit und spricht zugleich von einem möglichen Ausweg.",question:"In welcher Situation wird dein Muster besonders stark?"},{book:"JAS",chapter:1,from:12,to:15,label:"Jakobus 1,12–15",context:"Jakobus beschreibt, wie Begierde und Versuchung sich entwickeln können.",question:"Welchen frühen Moment könntest du künftig bewusster wahrnehmen?"}]},
 {id:"arbeit",icon:"□",title:"Arbeit & Berufung",sub:"Wenn Arbeit, Sinn oder Verantwortung dich beschäftigen",category:"berufung",refs:[{book:"COL",chapter:3,from:22,to:24,label:"Kolosser 3,22–24",context:"Der Abschnitt lenkt den Blick auf die innere Haltung bei der Arbeit.",question:"Welche Haltung möchtest du in deiner Arbeit bewahren, unabhängig von Anerkennung?"},{book:"1PE",chapter:4,from:10,to:11,label:"1. Petrus 4,10–11",context:"Gaben werden als etwas beschrieben, das zum Dienst an anderen eingesetzt werden kann.",question:"Welche Fähigkeit von dir könnte anderen konkret dienen?"}]},
 {id:"schuld",icon:"○",title:"Schuld",sub:"Wenn du etwas bereust oder Verantwortung tragen musst",category:"vergebung",refs:[{book:"1JN",chapter:1,from:8,to:9,label:"1. Johannes 1,8–9",context:"Der Text verbindet Ehrlichkeit über Schuld mit Vergebung.",question:"Was möchtest du klar benennen, statt es zu verdrängen?"},{book:"LUK",chapter:19,from:1,to:10,label:"Lukas 19,1–10",context:"Bei Zachäus wird Umkehr auch in konkretem Handeln sichtbar.",question:"Gibt es etwas, das du wiedergutmachen oder klären kannst?"}]},
 {id:"selbstbeherrschung",icon:"·",title:"Selbstbeherrschung",sub:"Wenn Impulse schneller sind als deine Entscheidungen",category:"geduld",refs:[{book:"GAL",chapter:5,from:22,to:25,label:"Galater 5,22–25",context:"Selbstbeherrschung wird als Teil der Frucht des Geistes genannt.",question:"In welchem Moment möchtest du künftig bewusster entscheiden?"},{book:"1CO",chapter:9,from:24,to:27,label:"1. Korinther 9,24–27",context:"Paulus nutzt das Bild von Training und bewusster Ausrichtung.",question:"Welche kleine Grenze würde dir helfen, nicht nur auf Impulse zu reagieren?"}]},
 {id:"ruhe",icon:"—",title:"Ruhe",sub:"Wenn dein Alltag keinen Raum lässt",category:"ruhe",refs:[{book:"MRK",chapter:6,from:30,to:32,label:"Markus 6,30–32",context:"Nach intensiver Arbeit lädt Jesus die Jünger an einen ruhigen Ort ein.",question:"Wo könntest du heute bewusst Raum statt noch mehr Leistung schaffen?"},{book:"HEB",chapter:4,from:9,to:11,label:"Hebräer 4,9–11",context:"Der Abschnitt spricht von einer Ruhe, die nicht nur Aktivität meint.",question:"Was macht es dir schwer, wirklich zur Ruhe zu kommen?"}]},
 {id:"geduld",icon:"…",title:"Geduld",sub:"Wenn etwas länger dauert als du möchtest",category:"geduld",refs:[{book:"ROM",chapter:12,from:12,to:12,label:"Römer 12,12",context:"Hoffnung, Geduld in Bedrängnis und Gebet werden miteinander verbunden.",question:"Wo möchtest du geduldig bleiben, ohne passiv zu werden?"},{book:"JAS",chapter:5,from:7,to:8,label:"Jakobus 5,7–8",context:"Jakobus nutzt das Bild des Wartens auf eine Ernte.",question:"Was kannst du pflegen, auch wenn du das Ergebnis noch nicht siehst?"}]}
);

const BEGINNER_GUIDES=[
 {id:"start",title:"Neu im Glauben – wo anfangen?",days:[
  ["Wer ist Jesus?","joh",1,1,18,"Lies langsam und achte darauf, wie Johannes Jesus beschreibt.","Welche Aussage über Jesus ist für dich neu oder wichtig?"],
  ["Jesus lädt Menschen ein","mar",1,14,20,"Jesus beginnt seinen Dienst und ruft Menschen, ihm zu folgen.","Was könnte 'Jesus folgen' für dich heute bedeuten?"],
  ["Mit Gott reden","mat",6,5,13,"Jesus erklärt Gebet ohne Show und gibt seinen Jüngern ein Gebet als Orientierung.","Was möchtest du Gott mit deinen eigenen Worten sagen?"],
  ["Gnade verstehen","eph",2,1,10,"Paulus beschreibt Rettung als Geschenk Gottes und nicht als Leistung.","Was verändert der Gedanke, dass Glaube nicht verdient werden muss?"],
  ["Die Bibel hören und tun","jak",1,19,25,"Jakobus verbindet Hören mit praktischem Handeln.","Was möchtest du aus dem Gelesenen konkret mitnehmen?"],
  ["Gemeinschaft","act",2,42,47,"Die ersten Christen lernen, beten, essen und leben gemeinsam.","Welche Rolle könnte christliche Gemeinschaft für dich haben?"],
  ["Dein nächster Schritt","php",1,3,11,"Glaube wird als etwas beschrieben, das weiter wachsen darf.","Was möchtest du als Nächstes kennenlernen oder ausprobieren?"]
 ]},
 {id:"gebet",title:"Gebet kennenlernen",days:[
  ["Einfach anfangen","mat",6,5,8,"Jesus macht deutlich, dass Gebet keine religiöse Show sein muss.","Was würdest du Gott sagen, wenn du keine besonderen Worte bräuchtest?"],
  ["Eine Orientierung","mat",6,9,13,"Das Vaterunser zeigt Themen, die im Gebet Raum haben können.","Welche Zeile spricht dich heute am meisten an?"],
  ["Sorgen aussprechen","php",4,6,7,"Paulus ermutigt, Anliegen im Gebet vor Gott zu bringen.","Welche Sorge möchtest du konkret aussprechen?"],
  ["Ehrlich beten","psa",13,1,6,"Der Psalm zeigt Klage, Fragen und Vertrauen in einem Gebet.","Was musst du vor Gott nicht schönreden?"]
 ]},
 {id:"jesus",title:"Jesus kennenlernen",days:[
  ["Jesus und die Ausgegrenzten","mar",2,13,17,"Jesus isst mit Menschen, die gesellschaftlich und religiös abgelehnt werden.","Was zeigt dir das über Jesus?"],
  ["Jesus und Angst","mar",4,35,41,"Die Jünger erleben Jesus mitten in einem Sturm.","Was fällt dir an ihrer Reaktion und Jesu Antwort auf?"],
  ["Jesus und Vergebung","luk",7,36,50,"Jesus begegnet einer Frau, die von anderen verurteilt wird.","Was lernst du hier über Vergebung und Liebe?"],
  ["Jesus und Zweifel","joh",20,24,29,"Thomas bringt seine Zweifel mit in die Begegnung mit Jesus.","Welche Frage würdest du Jesus stellen?"]
 ]}
];
function topicById(id){return LIFE_TOPICS.find(x=>x.id===id)}

const GUIDED_PLANS=[
 {id:"sorge7",title:"7 Tage – Vertrauen trotz Sorgen",sub:"Kurze Bibeltexte, ehrliche Reflexion, ein kleiner Schritt.",days:[
  ["Wenn Sorgen laut werden","php",4,6,7,"Was beschäftigt dich gerade am stärksten – und was davon kannst du heute konkret im Gebet benennen?"],
  ["Heute genügt","mat",6,25,34,"Welche Sorge gehört zu morgen und muss heute noch nicht gelöst werden?"],
  ["Angst benennen","psa",56,4,5,"Was verändert sich, wenn du deine Angst nicht verdrängst, sondern vor Gott aussprichst?"],
  ["Nicht allein tragen","1pe",5,6,7,"Welche Last versuchst du allein zu kontrollieren?"],
  ["Frieden bewahren","joh",14,25,27,"Was würde es heute praktisch bedeuten, Frieden nicht mit Kontrolle zu verwechseln?"],
  ["Hilfe erinnern","psa",121,1,8,"Wo hast du bereits Hilfe erlebt, die du in deiner aktuellen Sorge leicht vergisst?"],
  ["Zurückblicken","rom",8,31,39,"Was hast du in dieser Woche über deine Sorgen, dein Vertrauen und deinen nächsten Schritt erkannt?"]
 ]},
 {id:"konflikt5",title:"5 Tage – Mit Konflikten anders umgehen",sub:"Vom schnellen Reagieren zum bewussten nächsten Schritt.",days:[
  ["Erst hören","jak",1,19,20,"Wo wäre langsameres Reden heute hilfreicher als eine schnelle Antwort?"],
  ["Zorn verstehen","eph",4,26,32,"Was liegt unter deinem Ärger – Verletzung, Angst, Enttäuschung oder etwas anderes?"],
  ["Nicht vergelten","rom",12,17,21,"Welche Reaktion würde den Konflikt nicht weiter anheizen?"],
  ["Vergebung","col",3,12,14,"Was bedeutet Vergebung hier – und was bedeutet sie ausdrücklich nicht?"],
  ["Frieden suchen","mat",5,9,9,"Welchen kleinen, verantwortbaren Schritt zum Frieden kannst du tatsächlich gehen?"]
 ]},
 {id:"start7",title:"7 Tage – Neu im Glauben",sub:"Jesus, Gebet, Gnade, Bibel und Gemeinschaft kennenlernen.",days:[
  ["Wer ist Jesus?","joh",1,1,18,"Was fällt dir an der Beschreibung Jesu besonders auf?"],
  ["Jesus lädt ein","mar",1,14,20,"Was könnte Nachfolge in deinem jetzigen Alltag bedeuten?"],
  ["Beten lernen","mat",6,5,13,"Welcher Teil dieses Gebets spricht deine aktuelle Situation an?"],
  ["Gnade verstehen","eph",2,1,10,"Was bedeutet es für dich, dass Gnade nicht verdient werden muss?"],
  ["Hören und tun","jak",1,19,25,"Was könntest du aus dem Gelesenen konkret ausprobieren?"],
  ["Gemeinschaft","act",2,42,47,"Welche Rolle könnte Gemeinschaft in deinem Glauben spielen?"],
  ["Weitergehen","php",1,3,11,"Was möchtest du aus dieser Woche mitnehmen und weiterverfolgen?"]
 ]},
 {id:"gebet5",title:"5 Tage – Gebet kennenlernen",sub:"Ohne Leistungsdruck eine eigene Gebetspraxis entdecken.",days:[
  ["Nicht für Wirkung beten","mat",6,5,8,"Wie würdest du beten, wenn niemand außer Gott es hört?"],
  ["Ein einfaches Muster","mat",6,9,13,"Welche Zeile des Vaterunsers brauchst du heute besonders?"],
  ["Sorgen ins Gebet bringen","php",4,6,7,"Welche konkrete Sorge möchtest du heute aussprechen?"],
  ["Klage darf sein","psa",13,1,6,"Was würdest du Gott sagen, wenn du nichts beschönigen müsstest?"],
  ["Deinen Rhythmus finden","luk",5,15,16,"Welcher kleine, realistische Ort oder Zeitpunkt könnte dir beim Beten helfen?"]
 ]}
];
function normalizePlanProgress(raw,strict=false){if(raw==null)return {};if(typeof raw!=="object"||Array.isArray(raw)){if(strict)throw new Error("invalid guided plans");return {}}let out={};for(const p of GUIDED_PLANS){let src=raw[p.id];if(src==null)continue;if(typeof src!=="object"||Array.isArray(src)){if(strict)throw new Error("invalid guided plan");continue}let day={};p.days.forEach((_,i)=>{if(src[i]===true)day[i]=true;else if(strict&&src[i]!=null&&src[i]!==false)throw new Error("invalid guided day")});if(Object.keys(day).length)out[p.id]=day}return out}
function planProgress(){try{return normalizePlanProgress(JSON.parse(localStorage.getItem("faithpath.guidedPlans.v1")||"{}"))}catch(e){return {}}}
function setPlanDay(id,day,done){let p=planProgress(),plan=GUIDED_PLANS.find(x=>x.id===id);if(!plan||!Number.isInteger(day)||day<0||day>=plan.days.length)return;p[id]=p[id]||{};if(done)p[id][day]=true;else delete p[id][day];localStorage.setItem("faithpath.guidedPlans.v1",JSON.stringify(p))}
function openPlanPassage(id,i){let p=GUIDED_PLANS.find(x=>x.id===id),d=p?.days?.[i];if(!d)return;UI.readerBack={type:"plan",id};UI.readerTranslation=null;return openReader(d[1],d[2],d[3],d[4])}
function openPlan(id){let p=GUIDED_PLANS.find(x=>x.id===id);if(!p)return;let pr=planProgress()[id]||{},done=p.days.filter((_,i)=>pr[i]).length;
 $("#app").innerHTML=shell(`<main class="v3-plan"><button class="v2-back" onclick="renderPlans()">← Geführte Wege</button><header class="v3-planhead"><span>GEFÜHRTER WEG</span><h1>${esc(p.title)}</h1><p>${esc(p.sub)}</p><div class="v3-planprogress"><i style="width:${done/p.days.length*100}%"></i></div><small>${done} von ${p.days.length} Abschnitten abgeschlossen · kein Streak</small></header><div class="v3-days">${p.days.map((d,i)=>`<article class="v3-day ${pr[i]?"done":""}"><div class="v3-daytop"><span>TAG ${i+1}</span><button onclick="togglePlanDay('${p.id}',${i},${!pr[i]})">${pr[i]?"✓":"○"}</button></div><h2>${esc(d[0])}</h2><p>${esc(d[5])}</p><button class="v3-read" onclick="openPlanPassage('${p.id}',${i})">Bibeltext lesen →</button></article>`).join("")}</div></main>`) }
function togglePlanDay(id,i,v){setPlanDay(id,i,v);openPlan(id)}
function renderPlans(){let pr=planProgress();$("#app").innerHTML=shell(`<main class="v3-plans"><button class="v2-back" onclick="renderToday()">← Heute</button><header><span class="eyebrow">GEFÜHRTE WEGE</span><h1>Ein Thema.<br>Ein kleiner Schritt<br>pro Tag.</h1><p class="lead">Keine Serie, die du verlieren kannst. Kein Glaubensscore. Du gehst in deinem Tempo und kannst später zurückblicken.</p></header><div class="v3-planlist">${GUIDED_PLANS.map(p=>{let n=p.days.filter((_,i)=>pr[p.id]?.[i]).length;return `<button onclick="openPlan('${p.id}')"><div><span>${p.days.length} TAGE</span><b>${esc(p.title)}</b><small>${esc(p.sub)}</small></div><i>${n?p.days.length===n?"✓":n+"/"+p.days.length:"→"}</i></button>`}).join("")}</div></main>`)}
function renderGuidance(){
 $("#app").innerHTML=shell(`<main class="v2-guide"><button class="v2-back" onclick="renderToday()">← Heute</button><header class="v2-guidehead"><span>ORIENTIERUNG</span><h1>Du musst die<br>Bibelstelle noch<br>nicht kennen.</h1><p>Beginne bei dem, was du gerade erlebst. Wir zeigen dir mehrere Texte im Zusammenhang – nicht eine schnelle Antwort.</p></header><button class="v3-planhero" onclick="renderPlans()"><span>GEFÜHRTE WEGE</span><b>Ein Thema. Ein kleiner Schritt pro Tag.</b><small>Neu im Glauben · Sorgen · Konflikte · Gebet</small><i>→</i></button><div class="v2-topiclist">${LIFE_TOPICS.map((x,i)=>`<button onclick="openTopic('${x.id}')"><span class="v2-topicnum">${String(i+1).padStart(2,"0")}</span><div><b>${esc(x.title)}</b><small>${esc(x.sub)}</small></div><i>↗</i></button>`).join("")}</div><section class="v2-begin"><span class="v2-label">NEU IM GLAUBEN</span><h2>Geführt anfangen.</h2><p>Kein Vorwissen, kein Tempo, das du halten musst.</p>${BEGINNER_GUIDES.map(g=>`<button onclick="openGuide('${g.id}')"><b>${esc(g.title)}</b><span>${g.days.length} Abschnitte →</span></button>`).join("")}</section></main>`)
}function openTopicPassage(id,i){let x=topicById(id),r=x?.refs?.[i];if(!r)return;UI.readerBack={type:"topic",id};UI.readerTranslation=null;return openReader(r.book,r.chapter,r.from,r.to)}
function openTopic(id){let x=topicById(id);if(!x)return;$("#app").innerHTML=shell(`<button class="btn ghost" onclick="renderGuidance()">← Orientierung</button><div class="eyebrow" style="margin-top:18px">WAS BESCHÄFTIGT DICH?</div><h1>${esc(x.title)}</h1><p class="lead">${esc(x.sub)}. Lies nicht nur einen Satz – öffne den Abschnitt und schau auf den Zusammenhang.</p>${x.refs.map((r,i)=>`<section class="card verse-guide"><div class="row between"><span class="pill">Bibelstelle ${i+1}</span><b>${esc(r.label)}</b></div><p>${esc(r.context)}</p><div class="reflection-prompt"><span>REFLEXION</span>${esc(r.question)}</div><button class="btn secondary full" onclick="openTopicPassage('${x.id}',${i})">Abschnitt in der Bibel lesen</button></section>`).join("")}<button class="btn full" onclick="startTopicPath('${x.id}')">Daraus einen persönlichen Weg beginnen</button>`)
}
function startTopicPath(id){let x=topicById(id);if(!x)return;let cat=categoryById(x.category);openSheet(`<div class="eyebrow">${esc(cat.label.toUpperCase())}</div><h2>Dein Weg zu „${esc(x.title)}“</h2><p class="small muted">FaithPath schlägt einen Titel vor. Du kannst ihn ändern und selbst entscheiden, was dir wichtig ist.</p><input id="guidedTitle" value="${esc(x.title)}"><textarea id="guidedWhy" placeholder="Was beschäftigt dich daran persönlich?"></textarea><button class="btn full" onclick="saveTopicPath('${x.id}')">Weg beginnen</button>`)}
function saveTopicPath(id){let x=topicById(id),title=$("#guidedTitle")?.value.trim(),why=$("#guidedWhy")?.value.trim();if(!x||!title)return;let p={id:uid(),title,why,category:x.category,started:new Date().toISOString(),lastReview:null,steps:[],milestones:[],reviews:[],links:x.refs.map(r=>({id:uid(),kind:"verse",label:r.label,date:new Date().toISOString(),ref:{book:normBook(r.book),chapter:r.chapter,from:r.from,to:r.to,label:r.label,translation:S.translation}})),archived:false};S.paths.unshift(p);log("Weg begonnen: "+title,{pathId:p.id});save();closeSheet();openPath(p.id)}
function openGuidePassage(id,i){let g=BEGINNER_GUIDES.find(x=>x.id===id),d=g?.days?.[i];if(!d)return;UI.readerBack={type:"guide",id};UI.readerTranslation=null;return openReader(d[1],d[2],d[3],d[4])}
function openGuide(id){let g=BEGINNER_GUIDES.find(x=>x.id===id);if(!g)return;$("#app").innerHTML=shell(`<button class="btn ghost" onclick="renderGuidance()">← Orientierung</button><div class="eyebrow" style="margin-top:18px">GEFÜHRTER WEG</div><h1>${esc(g.title)}</h1><p class="lead">Kein Test und kein Leistungsplan. Geh Abschnitt für Abschnitt in deinem Tempo.</p><div class="guide-days">${g.days.map((d,i)=>`<section class="card guide-day"><div class="row between"><span class="pill">Abschnitt ${i+1}</span><b>${esc(d[0])}</b></div><p class="small muted">${esc(d[5])}</p><div class="reflection-prompt"><span>DENK DARÜBER NACH</span>${esc(d[6])}</div><button class="btn secondary full" onclick="openGuidePassage('${g.id}',${i})">Bibeltext lesen</button></section>`).join("")}</div>`)
}

function daysSince(d){let t=new Date(d||0).getTime();return t?Math.floor((Date.now()-t)/864e5):9999}
function sameRef(a,b){if(!a||!b)return false;return normBook(a.book)===normBook(b.book)&&Number(a.chapter)===Number(b.chapter)&&Number(a.from??0)===Number(b.from??0)&&Number(a.to??a.from??0)===Number(b.to??b.from??0)&&(a.translation||"otb")===(b.translation||"otb")}
function reminderGaps(){let out=[],now=new Date();for(const p of S.paths.filter(x=>!x.archived)){let age=daysSince(p.lastReview||p.started),key="path:"+p.id,snooze=S.reminderSnoozes[key],due=snooze?new Date(snooze)<=now:age>=21;if(due&&!S.dismissedGaps[key])out.push({key,type:"path",id:p.id,age,title:p.title,text:`Vor ${age} Tagen hast du an „${p.title}“ gearbeitet. Was ist daraus geworden?`})}for(const h of S.highlights){let age=daysSince(h.at),key="highlight:"+h.id,snooze=S.reminderSnoozes[key],due=snooze?new Date(snooze)<=now:age>=35,href={book:h.book,chapter:h.chapter,from:h.from,to:h.to,translation:h.translation||"otb"},hasLater=S.reflections.some(r=>new Date(r.date)>new Date(h.at||0)&&(r.highlightId?r.highlightId===h.id:sameRef(r.ref,href)));if(due&&!hasLater&&!S.dismissedGaps[key])out.push({key,type:"highlight",id:h.id,age,title:h.label,text:`Vor ${age} Tagen hast du ${h.label} markiert. Seitdem hast du dazu nichts festgehalten.`})}return out.sort((a,b)=>b.age-a.age)}
function openGap(key){let g=reminderGaps().find(x=>x.key===key);if(!g)return;if(g.type==="path"){reviewPath(g.id);return}let h=S.highlights.find(x=>x.id===g.id);openSheet(`<div class="eyebrow">ERINNERUNGSLÜCKE</div><h2>Was ist daraus geworden?</h2><p class="muted">${esc(g.text)}</p><textarea id="gapText" placeholder="Was hat sich verändert, was beschäftigt dich noch?"></textarea><button class="btn full" onclick="saveGapReflection('${g.key}')">Gedanken festhalten</button><div class="gap-actions"><button class="btn secondary" onclick="snoozeGap('${g.key}',14)">In 2 Wochen erinnern</button><button class="btn ghost" onclick="dismissGap('${g.key}')">Für jetzt abschließen</button></div>`)}
function saveGapReflection(key){let g=reminderGaps().find(x=>x.key===key),t=$("#gapText")?.value.trim();if(!g||!t)return;let h=S.highlights.find(x=>x.id===g.id),ref=h?{book:h.book,chapter:h.chapter,from:h.from,to:h.to,label:h.label,translation:h.translation||"otb"}:null,date=new Date().toISOString();S.journal.unshift({id:uid(),type:"Bibel",subtype:"Rückblick",text:t,date,ref});S.reflections.unshift({id:uid(),text:t,date,label:h?.label||g.title,highlightId:h?.id||null,ref});S.dismissedGaps[key]=date;log("Rückblick: "+(h?.label||g.title));save();closeSheet();toast("Rückblick gespeichert");renderToday()}
function snoozeGap(key,days){S.reminderSnoozes[key]=new Date(Date.now()+days*864e5).toISOString();save();closeSheet();renderToday()}
function dismissGap(key){S.dismissedGaps[key]=new Date().toISOString();save();closeSheet();renderToday()}
function mirroredReview(p,r){return (p.milestones||[]).some(m=>m.reviewId===r.id||(m.text===r.text&&Math.abs(new Date(m.date)-new Date(r.date))<5000))}
function renderHistory(reset=false){if(reset)UI.historyLimit=120;let items=[];S.highlights.forEach(h=>items.push({at:h.at,title:"Bibelstelle markiert",text:h.label}));S.journal.forEach(j=>items.push({at:j.date,title:j.subtype||j.type||"Journal",text:j.text}));S.paths.forEach(p=>{items.push({at:p.started,title:"Weg begonnen",text:p.title});(p.reviews||[]).filter(r=>!mirroredReview(p,r)).forEach(r=>items.push({at:r.date,title:"Rückblick · "+p.title,text:r.text}));(p.milestones||[]).forEach(m=>items.push({at:m.date,title:"Entwicklung · "+p.title,text:m.text}))});items.sort((a,b)=>new Date(b.at)-new Date(a.at));let shown=items.slice(0,UI.historyLimit);$("#app").innerHTML=shell(`<main class="history"><button class="textlink" onclick="go('more')">← Mehr</button><div class="eyebrow">DEINE GLAUBENSGESCHICHTE</div><h1>Was dich begleitet hat.</h1><p class="lead">Bibelstellen, Gedanken, Wege und Rückblicke in einem Verlauf.</p>${items.length?`<div class="history-line">${shown.map(i=>`<article><time>${fmt(i.at)}</time><div><b>${esc(i.title)}</b><p>${esc(i.text)}</p></div></article>`).join("")}</div>${shown.length<items.length?`<button class="btn secondary full" onclick="moreHistory()">Weitere anzeigen · ${items.length-shown.length} übrig</button>`:""}`:`<div class="empty-state"><b>Deine Geschichte beginnt hier.</b><p>Wenn du liest, reflektierst oder einen Weg beginnst, entsteht nach und nach dein persönlicher Verlauf.</p></div>`}</main>`)}
function moreHistory(){UI.historyLimit+=120;renderHistory()}
function pathActivityLabel(p){return p.lastReview?`letzter Rückblick ${fmt(p.lastReview)}`:`gestartet ${fmt(p.started)}`}
function renderToday(){let lvl=treeLevel(),active=S.paths.filter(p=>!p.archived),gaps=reminderGaps();
$("#app").innerHTML=shell(`<main class="home4"><header class="home4-head"><div class="eyebrow">HEUTE</div><h1>Was bewegt dich gerade?</h1><p>Du musst nicht wissen, wo du anfangen sollst.</p></header><section class="start-choice"><button class="start-primary" onclick="renderGuidance()"><span>Orientierung</span><b>Ich brauche einen Anfang</b><small>Situation wählen → Bibel verstehen → reflektieren</small></button><button class="start-secondary" onclick="UI.bibleTab='books';go('bible')"><span>Direkt</span><b>Zur Bibel</b><small>Buch und Kapitel öffnen</small></button></section>${gaps.length?`<section class="gap-strip"><div><span>RÜCKBLICK</span><h2>Was ist daraus geworden?</h2><p>${esc(gaps[0].text)}</p></div><button onclick="openGap('${gaps[0].key}')">Ansehen →</button>${gaps.length>1?`<small>+ ${gaps.length-1} weitere offene ${gaps.length-1===1?"Spur":"Spuren"}</small>`:""}</section>`:""}<section class="home-actions"><button onclick="go('paths')"><b>Mein Weg</b><span>${active.length?active.length+" aktive Wege":"Einen Weg beginnen"}</span></button><button onclick="newJournal()"><b>Festhalten</b><span>Gedanke, Gebet, Predigt</span></button><button onclick="renderHistory(true)"><b>Rückblick</b><span>Deine Geschichte ansehen</span></button></section><section class="tree4"><div class="tree4-image" style="background-image:url('trees/tree-stage-${lvl+1}.webp')"><div><span>DEINE GLAUBENSGESCHICHTE</span><h2>${stageNames[lvl]}</h2></div></div><footer><p>Der Baum zeigt nur Entwicklung, die du selbst festgehalten hast.</p><b>${S.paths.reduce((n,p)=>n+(p.milestones?.length||0),0)} Entwicklungen</b></footer></section>${active.length?`<section class="home-paths"><div class="section-title"><span>WEITERGEHEN</span><button onclick="go('paths')">Alle Wege</button></div>${active.slice(0,3).map(p=>`<button onclick="openPath('${p.id}')"><div><b>${esc(p.title)}</b><small>${categoryById(p.category).label} · ${pathActivityLabel(p)}</small></div><i>→</i></button>`).join("")}</section>`:""}<blockquote>FaithPath misst nicht deinen Glauben.<br><b>FaithPath hilft dir, deine Entwicklung zu erkennen.</b></blockquote></main>`) }
function tabs(items,current,fn){return `<div class="tabs">${items.map(x=>`<button class="${current===x[0]?"on":""}" onclick="${fn}('${x[0]}')">${x[1]}</button>`).join("")}</div>`}
function setBibleTab(t){UI.bibleTab=t;UI.readerBack=null;UI.readerTranslation=null;renderBible()}
function filterStories(q){q=String(q||"").trim().toLowerCase();$$(".story-entry").forEach(e=>e.style.display=!q||e.dataset.search.includes(q)?"":"none");$$(".story-group").forEach(g=>g.style.display=[...g.querySelectorAll(".story-entry")].some(e=>e.style.display!=="none")?"":"none")}
function renderBible(){UI.readerBack=null;UI.readerTranslation=null;let totalQ=stories.reduce((n,s)=>n+(s.questions?.length||0),0);let body=`<main class="bible4"><header><div class="eyebrow">BIBEL</div><h1>Lesen oder entdecken.</h1><p>Direkt in den Text – oder Zusammenhänge mit Geschichten und Fragen vertiefen.</p></header>${tabs([["books","Lesen"],["stories","Entdecken"],["marks","Markierungen"]],UI.bibleTab,"setBibleTab")}`;if(UI.bibleTab==="books"){body+=`${S.reading?`<button class="continue-reading" onclick="openReader('${S.reading.book}',${S.reading.chapter})"><span>WEITERLESEN</span><b>${esc((books.find(b=>b.code===S.reading.book)||{}).name||S.reading.book)} ${S.reading.chapter}</b><i>→</i></button>`:""}<div class="book-columns"><section><span>ALTES TESTAMENT</span>${bookList(books.slice(0,39))}</section><section><span>NEUES TESTAMENT</span>${bookList(books.slice(39))}</section></div>`}if(UI.bibleTab==="stories"){let groups=[...new Set(stories.map(s=>s.book))].map(code=>({code,name:(books.find(b=>b.code===code)||{}).name||code,items:stories.filter(s=>s.book===code)}));body+=`<div class="discover-meta"><b>${stories.length} Einheiten</b><span>${totalQ} Quizfragen · ohne Punktejagd</span></div><input class="discover-search" placeholder="Buch, Geschichte oder Bibelstelle suchen …" oninput="filterStories(this.value)"><div id="storyCatalog">${groups.map(g=>`<section class="story-group"><div class="section-title"><span>${esc(g.name.toUpperCase())}</span><small>${g.items.length} Einheiten</small></div>${g.items.map(s=>`<button class="story-entry" data-search="${esc((s.title+" "+s.ref+" "+g.name).toLowerCase())}" onclick="openStory(${s.id})"><div><b>${esc(s.title)}</b><small>${esc(s.ref)} · ${s.questions.length} Fragen</small></div><i>→</i></button>`).join("")}</section>`).join("")}</div>`}if(UI.bibleTab==="marks")body+=S.highlights.length?`<div class="mark-list">${S.highlights.map(h=>`<button onclick="openMarkRef('${h.id}')"><div><b>${esc(h.label)}</b><small>${fmt(h.at)} · ${esc(h.snippet||"")}</small></div><i>→</i></button>`).join("")}</div>`:`<div class="empty-state"><b>Noch keine Markierungen.</b><p>Öffne einen Bibeltext und tippe einzelne Verse an.</p></div>`;body+=`</main>`;$("#app").innerHTML=shell(body)}
function bookList(arr){return `<div class="list">${arr.map(b=>`<button onclick="openReader('${b.code}',1)"><span class="row between"><b>${esc(b.name)}</b><span class="small muted">${b.chapters} Kapitel ›</span></span></button>`).join("")}</div>`}
function activeTranslation(){return UI.readerTranslation&&TRANSLATIONS[UI.readerTranslation]?UI.readerTranslation:S.translation}
function knownRef(ref){if(!ref)return true;let b=books.find(x=>x.code===normBook(ref.book));return !!b&&Number.isInteger(Number(ref.chapter))&&Number(ref.chapter)>=1&&Number(ref.chapter)<=b.chapters}
function validateKnownState(state){let refs=[];state.journal.forEach(x=>x.ref&&refs.push(x.ref));state.reflections.forEach(x=>x.ref&&refs.push(x.ref));state.highlights.forEach(h=>refs.push({book:h.book,chapter:h.chapter}));state.paths.forEach(p=>p.links.forEach(l=>l.ref&&refs.push(l.ref)));if(state.reading)refs.push(state.reading);if(refs.some(r=>!knownRef(r)))throw new Error("unknown bible reference");return state}
async function getBook(code,translation=activeTranslation()){code=safeBook(code,true);let key=translation+":"+code;if(!bookCache[key])bookCache[key]=await fetch(`data/bibles/${translation}/${code}.json`).then(r=>{if(!r.ok)throw new Error("Bibeltext konnte nicht geladen werden");return r.json()});return bookCache[key]}
function setTranslation(t){if(!TRANSLATIONS[t])return;S.translation=t;UI.readerTranslation=null;save();if(UI.book)openReader(UI.book,UI.chapter);else renderBible()}
function openPassage(code,chapter,from,to){UI.readerBack=null;UI.readerTranslation=null;return openReader(code,chapter,from,to)}
function openSavedRef(book,chapter,from=null,to=null,translation=null,back=null){UI.readerTranslation=TRANSLATIONS[translation]?translation:null;if(back)UI.readerBack=back;return openReader(book,chapter,from,to)}
function openMarkRef(id){let h=S.highlights.find(x=>x.id===id);if(!h)return;return openSavedRef(h.book,h.chapter,h.from,h.to,h.translation||"otb",{type:"marks"})}
function openJournalRef(id){let j=S.journal.find(x=>x.id===id);if(!j?.ref)return;return openSavedRef(j.ref.book,j.ref.chapter,j.ref.from,j.ref.to,j.ref.translation||"otb",{type:"journal"})}
function readerBack(){let b=UI.readerBack;UI.readerBack=null;UI.readerTranslation=null;if(!b){renderBible();return}if(b.type==="story"){openStory(Number(b.id));return}if(b.type==="topic"){openTopic(b.id);return}if(b.type==="guide"){openGuide(b.id);return}if(b.type==="plan"){openPlan(b.id);return}if(b.type==="path"){openPath(b.id);return}if(b.type==="journal"){go("journal");return}if(b.type==="marks"){UI.bibleTab="marks";renderBible();return}renderBible()}
async function openReader(code,chapter=1,from=null,to=null){try{code=safeBook(code,true);chapter=Number(chapter);if(!Number.isInteger(chapter)||chapter<1)throw new Error("Ungültiges Kapitel");let tr=activeTranslation(),b=await getBook(code,tr),vs=b.chapters[chapter-1]||[];if(!vs.length)throw new Error("Kapitel nicht gefunden");UI.tab="bible";UI.book=code;UI.chapter=chapter;UI.selected=new Set();if(from){let start=Number(from),end=Number(to??from);vs.forEach(v=>{let n=Number(v[0]);if(n>=start&&n<=end)UI.selected.add(n)})}if(!UI.readerBack){S.reading={book:code,chapter};save()}$("#app").innerHTML=shell(`<div class="reader-head"><div class="row between"><button class="btn ghost" onclick="readerBack()">← ${UI.readerBack?"Zurück":"Bibel"}</button><select class="translation-select" onchange="setTranslation(this.value)">${Object.entries(TRANSLATIONS).map(([k,v])=>`<option value="${k}" ${tr===k?"selected":""}>${v.label}</option>`).join("")}</select></div><div class="row between" style="margin-top:10px"><select style="width:62%" onchange="openReader(this.value,1)">${books.map(x=>`<option value="${x.code}" ${x.code===code?"selected":""}>${esc(x.name)}</option>`).join("")}</select><select style="width:35%" onchange="openReader('${code}',Number(this.value))">${b.chapters.map((_,i)=>`<option ${i+1===chapter?"selected":""}>${i+1}</option>`).join("")}</select></div></div><h1>${esc(b.name)} ${chapter}</h1><div id="verses">${vs.map(v=>`<div class="verse ${isMarked(code,chapter,v[0],tr)?"marked":""} ${UI.selected.has(Number(v[0]))?"selected":""}" data-v="${v[0]}" onclick="toggleVerse(${v[0]})"><span class="num">${v[0]}</span><span>${esc(v[1])}</span></div>`).join("")}</div><div id="selbar"></div>`);renderSelectBar();return true}catch(e){toast("Bibeltext konnte nicht geladen werden");return false}}
function isMarked(book,ch,v,translation=activeTranslation()){return S.highlights.some(h=>h.book===book&&h.chapter===ch&&v>=h.from&&v<=h.to&&(h.translation||"otb")===translation)}
function toggleVerse(v){if(UI.selected.has(v))UI.selected.delete(v);else UI.selected.add(v);$$(".verse").forEach(e=>e.classList.toggle("selected",UI.selected.has(Number(e.dataset.v))));renderSelectBar()}
function selectedRange(){let a=[...UI.selected].sort((a,b)=>a-b);if(!a.length)return null;for(let i=1;i<a.length;i++)if(a[i]!==a[i-1]+1)return null;return {from:a[0],to:a[a.length-1]}}
function renderSelectBar(){let host=$("#selbar");if(!host)return;if(!UI.selected.size){host.innerHTML="";return}let r=selectedRange();host.innerHTML=r?`<div class="selectbar"><button onclick="markSelection()">Markieren</button><button onclick="noteSelection()">Notiz</button><button onclick="connectSelection()">Mit Weg</button><button onclick="copySelection()">Kopieren</button><button class="close" onclick="clearSelection()">×</button></div>`:`<div class="selectbar"><span>Bitte zusammenhängende Verse auswählen.</span><button class="close" onclick="clearSelection()">×</button></div>`}
async function selInfo(){let r=selectedRange();if(!r)return null;let b=await getBook(UI.book),vs=b.chapters[UI.chapter-1],chosen=vs.filter(v=>UI.selected.has(Number(v[0])));return {r,b,chosen,text:chosen.map(v=>`${v[0]} ${v[1]}`).join(" "),label:`${b.name} ${UI.chapter},${r.from}${r.to>r.from?"–"+r.to:""}`,translation:activeTranslation()}}
async function markSelection(){let x=await selInfo();if(!x){toast("Bitte zusammenhängende Verse auswählen");return}let ref={book:UI.book,chapter:UI.chapter,from:x.r.from,to:x.r.to,translation:x.translation};if(S.highlights.some(h=>sameRef(h,ref))){toast("Diese Stelle ist bereits markiert");clearSelection();return}S.highlights.push({id:uid(),book:UI.book,chapter:UI.chapter,from:x.r.from,to:x.r.to,label:x.label,snippet:x.text.slice(0,180),translation:x.translation,at:new Date().toISOString()});log("Bibelstelle markiert: "+x.label);toast("Markierung gespeichert");openReader(UI.book,UI.chapter)}
async function noteSelection(){let x=await selInfo();if(!x){toast("Bitte zusammenhängende Verse auswählen");return}openSheet(`<div class="eyebrow">${esc(x.label)}</div><h2>Was bleibt dir?</h2><textarea id="noteText" placeholder="Deine Gedanken zur Bibelstelle …"></textarea><button class="btn full" onclick="saveBibleNote()">Notiz speichern</button>`);UI.pending=x}
function saveBibleNote(){let t=$("#noteText")?.value.trim(),x=UI.pending;if(!t||!x)return;let date=new Date().toISOString(),ref={book:UI.book,chapter:UI.chapter,from:x.r.from,to:x.r.to,label:x.label,translation:x.translation},match=S.highlights.filter(h=>sameRef(h,ref)).sort((a,b)=>new Date(b.at)-new Date(a.at))[0];S.journal.unshift({id:uid(),type:"Bibel",text:t,date,ref});S.reflections.unshift({id:uid(),text:t,date,label:x.label,highlightId:match?.id||null,ref});log("Reflexion: "+x.label);UI.pending=null;save();closeSheet();toast("Notiz gespeichert")}
async function copySelection(){let x=await selInfo();if(!x){toast("Bitte zusammenhängende Verse auswählen");return}let txt=`${x.label}\n${x.chosen.map(v=>v[0]+" "+v[1]).join("\n")}`;try{await navigator.clipboard.writeText(txt);toast("Verse kopiert")}catch{let ta=document.createElement("textarea");ta.value=txt;document.body.appendChild(ta);ta.select();let ok=false;try{ok=document.execCommand("copy")}catch{}ta.remove();toast(ok?"Verse kopiert":"Kopieren nicht möglich")}}
async function connectSelection(){let x=await selInfo();if(!x){toast("Bitte zusammenhängende Verse auswählen");return}UI.pending=x;choosePathSheet()}
function clearSelection(){UI.selected.clear();$$(".verse").forEach(e=>e.classList.remove("selected"));renderSelectBar()}
function choosePathSheet(){let paths=S.paths.filter(p=>!p.archived),kind=UI.pending?.kind==="reflection"?"Die Reflexion":"Die Bibelstelle";openSheet(`<h2>Mit einem Weg verbinden</h2><p class="small muted">${kind} bleibt Teil der Geschichte dieses Weges.</p>${paths.length?`<div class="list">${paths.map(p=>`<button onclick="attachPending('${p.id}')"><b>${esc(p.title)}</b></button>`).join("")}</div>`:"<p class='muted'>Du hast noch keinen Weg.</p>"}<button class="btn secondary full" style="margin-top:10px" onclick="closeSheet();newPath(true)">Neuen Weg beginnen</button>`)}
function pendingLink(){let x=UI.pending;if(!x)return null;if(x.kind==="reflection"&&x.ref)return {id:uid(),kind:"reflection",date:new Date().toISOString(),label:x.label,storyId:x.storyId,reflectionId:x.reflectionId,ref:{...x.ref}};if(x.r)return {id:uid(),kind:"verse",date:new Date().toISOString(),label:x.label,ref:{book:UI.book,chapter:UI.chapter,from:x.r.from,to:x.r.to,translation:x.translation||activeTranslation()}};return null}
function attachPending(id){let p=S.paths.find(p=>p.id===id),link=pendingLink();if(!p||!link){toast("Verbindung konnte nicht gespeichert werden");return}p.links=p.links||[];p.links.push(link);log(link.label+" mit Weg „"+p.title+"“ verbunden",{pathId:id});UI.pending=null;save();closeSheet();toast("Mit Weg verbunden")}
function openStoryPassage(id){let s=stories.find(x=>x.id===id);if(!s)return;UI.readerBack={type:"story",id};UI.readerTranslation=null;return openReader(s.book,s.chapter+1,s.from,s.to)}
function openStory(id){let s=stories.find(x=>x.id===id);if(!s)return;UI.story=s;UI.qi=0;UI.answered=null;$("#app").innerHTML=shell(`<button class="btn ghost" onclick="renderBible()">← Geschichten</button><section class="card" style="margin-top:12px"><span class="pill">${esc(s.ref)}</span><h1 style="margin-top:10px">${esc(s.title)}</h1><p class="lead">${esc(s.desc)}</p><div class="row"><button class="btn secondary grow" onclick="openStoryPassage(${s.id})">Abschnitt lesen</button><button class="btn grow" onclick="startQuiz(${s.id})">Quiz starten</button></div></section><section class="card"><div class="eyebrow">REFLEXION</div><h2 style="margin:7px 0">${esc(s.reflection)}</h2><textarea id="storyRef" placeholder="Es gibt hier kein richtig oder falsch."></textarea><button class="btn full" onclick="saveStoryReflection(${s.id})">Reflexion speichern</button></section>`)}
function startQuiz(id){UI.story=stories.find(x=>x.id===id);if(!UI.story)return;UI.qi=0;UI.answered=null;renderQuiz()}
function renderQuiz(){let s=UI.story,q=s?.questions?.[UI.qi];if(!s||!q){renderBible();return}let pct=Math.round((UI.qi+(UI.answered!=null?1:0))/s.questions.length*100);$("#app").innerHTML=shell(`<button class="btn ghost" onclick="openStory(${s.id})">← Geschichte</button><section class="card" style="margin-top:12px"><div class="row between small muted"><span>${esc(s.ref)}</span><span>${UI.qi+1} / ${s.questions.length}</span></div><div class="progress" style="margin:10px 0 18px"><i style="width:${pct}%"></i></div><h2>${esc(q.q)}</h2><div>${q.a.map((a,i)=>`<button class="answer ${UI.answered!=null?(i===q.c?"good":i===UI.answered?"bad":""):""}" ${UI.answered!=null?"disabled":""} onclick="answerQuiz(${i})">${String.fromCharCode(65+i)} · ${esc(a)}</button>`).join("")}</div>${UI.answered!=null?`<div class="explain"><b>${UI.answered===q.c?"Richtig":"Nicht ganz"}</b><br>${esc(q.x)}<br><span class="muted">${esc(q.ref||q.p||"")}</span></div><button class="btn full" style="margin-top:12px" onclick="nextQuiz()">${UI.qi===s.questions.length-1?"Zur Reflexion":"Nächste Frage"}</button>`:""}</section>`)}
function answerQuiz(i){let q=UI.story?.questions?.[UI.qi];if(!q||!Number.isInteger(i)||i<0||i>=q.a.length||UI.answered!=null)return;UI.answered=i;renderQuiz()}
function nextQuiz(){let s=UI.story;if(!s)return;if(UI.qi<s.questions.length-1){UI.qi++;UI.answered=null;renderQuiz()}else{S.quiz[s.id]={done:new Date().toISOString()};save();openStory(s.id);setTimeout(()=>$("#storyRef")?.focus(),80)}}
function saveStoryReflection(id){let s=stories.find(x=>x.id===id),t=$("#storyRef")?.value.trim();if(!s||!t)return;let rid=uid(),date=new Date().toISOString(),ref={book:s.book,chapter:s.chapter+1,from:s.from,to:s.to,label:s.ref,translation:activeTranslation()};S.reflections.unshift({id:rid,storyId:id,text:t,date,label:s.title,ref});S.journal.unshift({id:uid(),type:"Bibel",subtype:"Reflexion",text:t,date,storyId:id,ref});log("Reflexion: "+s.title);save();UI.pending={kind:"reflection",label:s.title,storyId:id,reflectionId:rid,ref};openSheet(`<h2>Reflexion gespeichert</h2><p class="muted">Soll dieser Gedanke Teil eines deiner Wege werden?</p><button class="btn full" onclick="choosePathSheet()">Mit Weg verbinden</button><button class="btn secondary full" style="margin-top:8px" onclick="closeSheet()">Später</button>`)}
function renderPaths(){let active=S.paths.filter(p=>!p.archived);$("#app").innerHTML=shell(`<main class="paths4"><header class="split-head"><div><div class="eyebrow">MEIN WEG</div><h1>Woran möchtest du wachsen?</h1><p>Ein Weg ist keine Aufgabenliste. Er sammelt, was dich über Zeit begleitet.</p></div><button class="round" onclick="newPath()">＋</button></header>${active.length?`<div class="path-feature">${active.map((p,i)=>`<button onclick="openPath('${p.id}')"><span>${String(i+1).padStart(2,"0")}</span><div><b>${esc(p.title)}</b><small>${categoryById(p.category).label} · seit ${fmt(p.started)}</small><p>${esc(p.why||"")}</p></div><i>→</i></button>`).join("")}</div>`:`<div class="empty-state"><b>Dein erster Weg kann klein anfangen.</b><p>Wähle einen Bereich, der dich wirklich beschäftigt. Schritte helfen – aber nur du entscheidest, ob daraus Entwicklung geworden ist.</p><button class="btn" onclick="newPath()">Weg beginnen</button></div>`}</main>`)}
const PATH_CATEGORIES=[
 {id:"gebet",label:"Gebet & Nähe zu Gott",steps:["Plane für diese Woche drei kurze, ungestörte Gebetszeiten ein.","Verbinde einen Bibelvers, der dein Gebet begleitet, mit diesem Weg.","Halte nach einer Woche fest, was sich in deinem Gebet verändert oder beschäftigt hat."]},
 {id:"bibel",label:"Bibel & Gottes Wort",steps:["Lies an drei Tagen einen kurzen Abschnitt bewusst und ohne Zeitdruck.","Markiere einen Vers, der dich besonders anspricht, und verbinde ihn mit diesem Weg.","Schreibe nach dem Lesen einen Satz dazu auf, was du verstanden oder mitgenommen hast."]},
 {id:"vertrauen",label:"Vertrauen & Angst",steps:["Benenne eine konkrete Sorge und bringe sie bewusst im Gebet vor Gott.","Wähle einen Bibelvers über Vertrauen oder Mut und kehre diese Woche zu ihm zurück.","Halte eine Situation fest, in der du trotz Unsicherheit einen kleinen Schritt gegangen bist."]},
 {id:"geduld",label:"Geduld & Selbstbeherrschung",steps:["Wähle eine typische Situation, in der du diese Woche bewusst langsamer reagieren möchtest.","Mach vor einer schwierigen Reaktion eine kurze Pause und entscheide dann, wie du antwortest.","Blicke am Ende der Woche auf eine Situation zurück: Was lief anders als sonst?"]},
 {id:"vergebung",label:"Vergebung & Versöhnung",steps:["Schreibe für dich auf, was dich an der Situation noch beschäftigt.","Lies eine passende Bibelstelle über Vergebung und notiere, was dich daran herausfordert.","Überlege einen kleinen nächsten Schritt, der Frieden fördern könnte – ohne dich zu etwas zu zwingen."]},
 {id:"beziehungen",label:"Beziehungen & Familie",steps:["Nimm dir diese Woche bewusst Zeit für ein Gespräch, in dem du zuerst zuhörst.","Überlege, wem du konkret Wertschätzung zeigen möchtest, und setze es in einer kleinen Handlung um.","Halte eine Begegnung fest, in der du anders reagieren möchtest oder bereits anders reagiert hast."]},
 {id:"naechstenliebe",label:"Nächstenliebe & Dienen",steps:["Achte diese Woche bewusst auf eine Person, der du praktisch helfen kannst.","Setze eine kleine hilfreiche Handlung um, ohne eine Gegenleistung zu erwarten.","Halte danach fest, was du über die andere Person oder über dich selbst bemerkt hast."]},
 {id:"dankbarkeit",label:"Dankbarkeit & Zufriedenheit",steps:["Notiere an drei Tagen jeweils eine Sache, für die du Gott dankbar bist.","Verbinde einen Psalm oder Vers über Dankbarkeit mit diesem Weg.","Blicke am Ende der Woche zurück: Was hast du bewusster wahrgenommen?"]},
 {id:"glaube",label:"Glaube & Zweifel",steps:["Schreibe eine Frage oder einen Zweifel auf, den du nicht einfach übergehen möchtest.","Suche eine Bibelstelle, die zu deiner Frage passt, und verbinde sie mit diesem Weg.","Halte später fest, ob sich deine Sicht verändert hat oder die Frage weiterhin offen ist."]},
 {id:"hoffnung",label:"Hoffnung & schwierige Zeiten",steps:["Benenne, was dir gerade Hoffnung nimmt oder schwerfällt.","Wähle eine Bibelstelle über Hoffnung und lies sie diese Woche mehrmals bewusst.","Halte einen kleinen Moment fest, in dem du trotz der Situation Hoffnung oder Ermutigung erlebt hast."]},
 {id:"charakter",label:"Charakter & persönliche Entwicklung",steps:["Formuliere eine konkrete Eigenschaft, die du diese Woche bewusster leben möchtest.","Wähle eine Alltagssituation, in der du diese Eigenschaft praktisch üben kannst.","Prüfe nach einer Woche an einem konkreten Beispiel, was sich verändert hat und was noch schwerfällt."]},
 {id:"disziplin",label:"Disziplin & Gewohnheiten",steps:["Wähle eine kleine Handlung, die du diese Woche dreimal umsetzen kannst.","Lege einen konkreten Zeitpunkt oder Auslöser für deinen nächsten Schritt fest.","Prüfe nach sieben Tagen, was funktioniert hat, und passe den Schritt bei Bedarf an."]},
 {id:"entscheidung",label:"Entscheidungen & Orientierung",steps:["Schreibe die Entscheidung und die wichtigsten offenen Fragen in wenigen Sätzen auf.","Nimm dir bewusst Zeit für Gebet und verbinde eine passende Bibelstelle mit diesem Weg.","Lege einen nächsten kleinen Schritt fest, mit dem du mehr Klarheit gewinnen kannst."]},
 {id:"berufung",label:"Berufung & Gaben",steps:["Notiere eine Gabe oder Stärke, die du bewusster einsetzen möchtest.","Suche diese Woche eine konkrete Gelegenheit, diese Gabe für einen anderen Menschen einzusetzen.","Halte fest, was dir dabei Freude gegeben oder dich herausgefordert hat."]},
 {id:"gemeinde",label:"Gemeinde & Gemeinschaft",steps:["Suche diese Woche bewusst das Gespräch mit einer Person aus deiner Gemeinde oder Gemeinschaft.","Überlege, wo du dich mit einer kleinen konkreten Handlung einbringen kannst.","Halte fest, wo du Gemeinschaft als stärkend erlebt hast oder was dir dabei noch fehlt."]},
 {id:"ruhe",label:"Ruhe & Alltag mit Gott",steps:["Plane einen kurzen Zeitraum ohne Handy oder andere Ablenkung ein.","Nutze diese Zeit für Stille, Gebet oder einen kurzen Bibelabschnitt.","Halte danach fest, was in der Ruhe bei dir präsent geworden ist."]},
 {id:"sonstiges",label:"Eigener Bereich",steps:["Formuliere eine kleine konkrete Handlung, die zu diesem Weg passt und diese Woche machbar ist.","Verbinde einen Bibelvers oder Gedanken, der dir für diesen Weg Orientierung gibt.","Setze dir einen Zeitpunkt für einen kurzen Rückblick: Was ist daraus geworden?"]}
];
function categoryById(id){return PATH_CATEGORIES.find(c=>c.id===id)||PATH_CATEGORIES[PATH_CATEGORIES.length-1]}
function newPath(connectPending=false){UI.connectPendingOnCreate=!!connectPending;openSheet(`<div class="eyebrow">NEUER WEG</div><h2>Woran möchtest du wachsen?</h2><div class="field"><label>Bereich</label><select id="pathCategory">${PATH_CATEGORIES.map(c=>`<option value="${c.id}">${esc(c.label)}</option>`).join("")}</select></div><div class="field"><label>Titel</label><input id="pathTitle" placeholder="z. B. ruhiger reagieren"></div><div class="field"><label>Warum ist dir das wichtig?</label><textarea id="pathWhy" placeholder="Deine eigene Motivation …"></textarea></div><button class="btn full" onclick="createPath()">Weg beginnen</button>`)}
function createPath(){let t=$("#pathTitle")?.value.trim(),w=$("#pathWhy")?.value.trim(),c=$("#pathCategory")?.value||"sonstiges";if(!t)return;let p={id:uid(),title:t,why:w,category:c,started:new Date().toISOString(),lastReview:null,steps:[],milestones:[],reviews:[],links:[],archived:false};S.paths.unshift(p);if(UI.connectPendingOnCreate){let link=pendingLink();if(link){p.links.push(link);UI.pending=null}}UI.connectPendingOnCreate=false;log("Weg begonnen: "+t,{pathId:p.id});save();closeSheet();openPath(p.id)}
function openPath(id){let p=S.paths.find(x=>x.id===id);if(!p)return;UI.tab="paths";UI.path=id;let links=p.links||[],cat=categoryById(p.category);$("#app").innerHTML=shell(`<button class="btn ghost" onclick="renderPaths()">← Meine Wege</button><section class="card" style="margin-top:12px"><div class="eyebrow">${esc(cat.label.toUpperCase())} · SEIT ${fmt(p.started).toUpperCase()}</div><h1 style="margin-top:6px">${esc(p.title)}</h1><p class="lead">${esc(p.why||"")}</p><div class="grid2"><div class="stat"><b>${p.milestones.length}</b><span class="small muted">Entwicklungen</span></div><div class="stat"><b>${links.length}</b><span class="small muted">Verbindungen</span></div></div></section><section class="card"><h2>Nächster Schritt</h2>${p.steps.length?p.steps.map((s,i)=>`<label class="row" style="margin:10px 0"><input class="check" type="checkbox" ${s.done?"checked":""} onchange="toggleStep('${id}',${i})"><span>${esc(s.text)}</span></label>`).join(""):"<p class='muted small'>Noch keine Schritte. Sie lassen den Baum nicht wachsen – sie helfen nur beim Handeln.</p>"}<button class="btn secondary full" onclick="addStep('${id}')">Schritt auswählen</button></section><section class="card"><h2>Rückblick</h2><p class="muted small">Was ist aus diesem Weg geworden? Du entscheidest selbst, ob daraus eine echte Entwicklung entstanden ist.</p><button class="btn full" onclick="reviewPath('${id}')">Rückblick festhalten</button></section>${p.milestones.length?`<section class="card"><div class="eyebrow">BESTÄTIGTE ENTWICKLUNG</div>${p.milestones.map(m=>`<div class="event"><b>${esc(m.text)}</b><div class="small muted">${fmt(m.date)}</div></div>`).join("")}</section>`:""}${links.length?`<section class="card"><h2>Verbunden</h2><div class="list">${links.map(l=>`<button onclick="openPathLink('${id}','${l.id}')"><div class="row between"><div style="text-align:left"><b>${esc(l.label)}</b><div class="small muted">${fmt(l.date)} · ${l.kind==="reflection"?"Reflexion":"Bibelstelle"}</div></div><i>→</i></div></button>`).join("")}</div></section>`:""}<div class="dangerzone"><button class="btn danger full" onclick="deletePath('${id}')">Weg löschen</button></div>`)}
function openPathLink(pathId,linkId){let p=S.paths.find(x=>x.id===pathId),l=p?.links?.find(x=>x.id===linkId);if(!l)return;if(l.kind==="reflection"&&l.reflectionId){let r=S.reflections.find(x=>x.id===l.reflectionId);if(r){let ref=l.ref;openSheet(`<div class="eyebrow">VERBUNDENE REFLEXION</div><h2>${esc(l.label)}</h2><p>${esc(r.text)}</p>${ref?.book&&ref?.chapter?`<button class="btn secondary full" onclick="openPathLinkBible('${pathId}','${linkId}')">Bibeltext öffnen</button>`:""}`);return}}if(l.ref?.book&&l.ref?.chapter){UI.readerBack={type:"path",id:pathId};openSavedRef(l.ref.book,l.ref.chapter,l.ref.from??null,l.ref.to??null,l.ref.translation||"otb",UI.readerBack)}}
function openPathLinkBible(pathId,linkId){let p=S.paths.find(x=>x.id===pathId),l=p?.links?.find(x=>x.id===linkId),ref=l?.ref;if(!ref)return;closeSheet();UI.readerBack={type:"path",id:pathId};openSavedRef(ref.book,ref.chapter,ref.from??null,ref.to??null,ref.translation||"otb",UI.readerBack)}
function suggestedSteps(p){let cat=categoryById(p.category);return cat.steps.filter(t=>!(p.steps||[]).some(s=>s.text===t))}
function addSuggestedStep(id,idx){let p=S.paths.find(p=>p.id===id),items=suggestedSteps(p),t=items[idx];if(!t)return;p.steps.push({text:t,done:false,suggested:true});save();closeSheet();openPath(id);toast("Schritt übernommen")}
function addStep(id){let p=S.paths.find(p=>p.id===id),items=suggestedSteps(p),cat=categoryById(p.category);openSheet(`<div class="eyebrow">${esc(cat.label.toUpperCase())}</div><h2>Vorgeschlagene Schritte</h2><p class="small muted">FaithPath gibt dir Anstöße. Du entscheidest, was zu deinem Weg passt.</p>${items.length?`<div class="list">${items.map((t,i)=>`<button onclick="addSuggestedStep('${id}',${i})"><div class="row between"><span style="text-align:left">${esc(t)}</span><span>＋</span></div></button>`).join("")}</div>`:`<p class="small muted">Du hast die Vorschläge dieser Kategorie bereits übernommen.</p>`}<button class="btn secondary full" style="margin-top:12px" onclick="ownStep('${id}')">＋ Eigener Schritt</button>`)}
function ownStep(id){openSheet(`<div class="eyebrow">EIGENER SCHRITT</div><h2>Was möchtest du konkret tun?</h2><input id="stepText" placeholder="Dein nächster Schritt …"><button class="btn full" style="margin-top:10px" onclick="saveStep('${id}')">Schritt übernehmen</button>`)}
function saveStep(id){let t=$("#stepText")?.value.trim(),p=S.paths.find(x=>x.id===id);if(!t||!p)return;p.steps.push({text:t,done:false,suggested:false});save();closeSheet();openPath(id)}
function toggleStep(id,i){let p=S.paths.find(p=>p.id===id),step=p?.steps?.[i];if(!step)return;step.done=!step.done;save()}
function reviewPath(id){let p=S.paths.find(x=>x.id===id);if(!p)return;openSheet(`<div class="eyebrow">RÜCKBLICK · ${esc(p.title.toUpperCase())}</div><h2>Was ist daraus geworden?</h2><p class="muted">Keine Bewertung. Du entscheidest selbst, was sich verändert hat.</p><div class="field"><label>Wo stehst du gerade?</label><select id="reviewStatus"><option value="changed">Etwas hat sich verändert</option><option value="working">Ich arbeite noch daran</option><option value="notnow">Im Moment nicht</option><option value="thought">Ich möchte nur einen Gedanken festhalten</option><option value="later">Später erinnern</option></select></div><textarea id="reviewText" placeholder="Was möchtest du dazu festhalten?"></textarea><div class="field"><label><input class="check" id="reviewMilestone" type="checkbox"> Das ist für mich eine echte Entwicklung, die ich festhalten möchte</label></div><button class="btn full" onclick="saveReview('${id}')">Rückblick speichern</button>`)}
function saveReview(id){let p=S.paths.find(p=>p.id===id),t=$("#reviewText")?.value.trim(),status=$("#reviewStatus")?.value,yes=!!$("#reviewMilestone")?.checked;if(!p||!REVIEW_STATUSES.has(status))return;if(status==="later"){S.reminderSnoozes["path:"+id]=new Date(Date.now()+14*864e5).toISOString();save();closeSheet();toast("In 2 Wochen wieder erinnern");openPath(id);return}if(!t)t=status==="working"?"Ich arbeite noch daran.":status==="notnow"?"Im Moment hat sich nichts verändert.":"Rückblick festgehalten.";let date=new Date().toISOString(),reviewId=uid(),review={id:reviewId,date,text:t,status,confirmedDevelopment:yes};p.reviews.push(review);p.lastReview=date;delete S.reminderSnoozes["path:"+id];delete S.dismissedGaps["path:"+id];if(yes)p.milestones.push({id:uid(),date,text:t,reviewId});log("Rückblick: "+p.title,{pathId:id});save();closeSheet();toast(yes?"Entwicklung festgehalten":"Rückblick gespeichert");openPath(id)}
function deletePath(id){openSheet(`<h2>Weg wirklich löschen?</h2><p class="muted">Der Weg und seine Rückblicke werden entfernt. Deine Bibelmarkierungen und Journaltexte bleiben erhalten.</p><button class="btn danger full" onclick="confirmDeletePath('${id}')">Endgültig löschen</button><button class="btn secondary full" style="margin-top:8px" onclick="closeSheet()">Abbrechen</button>`)}
function confirmDeletePath(id){let before=S.paths.length;S.paths=S.paths.filter(p=>p.id!==id);if(S.paths.length===before)return;S.events=S.events.filter(e=>e.pathId!==id);delete S.reminderSnoozes["path:"+id];delete S.dismissedGaps["path:"+id];if(UI.path===id)UI.path=null;save();closeSheet();renderPaths()}
function renderJournal(){let types=["Alle","Bibel","Ziele","Predigt"],items=S.journal.filter(j=>UI.journalFilter==="Alle"||j.type===UI.journalFilter);$("#app").innerHTML=shell(`<main class="journal4"><header class="split-head"><div><div class="eyebrow">JOURNAL</div><h1>Festhalten, was bleibt.</h1><p>Gedanken, Bibelnotizen und Predigten – chronologisch statt als Aufgaben.</p></div><button class="round" onclick="newJournal()">＋</button></header>${tabs(types.map(x=>[x,x]),UI.journalFilter,"setJournalFilter")}${items.length?`<div class="journal-line">${items.map(j=>`<article><time>${fmt(j.date)}</time><div><span>${esc(j.subtype||j.type)}</span><p>${esc(j.text)}</p>${j.ref?.book&&j.ref?.chapter?`<button onclick="openJournalRef('${j.id}')">${esc(j.ref.label||"Bibelstelle")} →</button>`:""}</div></article>`).join("")}</div>`:`<div class="empty-state"><b>Hier ist noch nichts festgehalten.</b><p>Ein Gedanke reicht. FaithPath soll dir später helfen, ihn wiederzufinden.</p></div>`}</main>`)}
function setJournalFilter(x){UI.journalFilter=x;renderJournal()}
function newJournal(){openSheet(`<h2>Neuer Eintrag</h2><div class="field"><label>Art</label><select id="jtype"><option>Journal</option><option>Predigt</option><option>Gebet</option><option>Dankbarkeit</option><option>Ziele</option></select></div><textarea id="jtext" placeholder="Was möchtest du festhalten?"></textarea><button class="btn full" style="margin-top:10px" onclick="saveJournal()">Speichern</button>`)}
function saveJournal(){let t=$("#jtext").value.trim(),type=$("#jtype").value;if(!t)return;let normalized=["Predigt","Ziele"].includes(type)?type:"Journal";S.journal.unshift({id:uid(),type:normalized,subtype:type,text:t,date:new Date().toISOString()});log(type+" festgehalten");save();closeSheet();renderJournal()}
const BUILD="FaithPath V4 · FP4-20260916-E · 1560Q";
function renderMore(){let gaps=reminderGaps();$("#app").innerHTML=shell(`<main class="more4"><header><div class="eyebrow">MEHR</div><h1>Deine Daten. Deine Geschichte.</h1></header><div class="settings-list"><button onclick="renderHistory(true)"><div><b>Glaubensgeschichte</b><span>Bibel, Journal, Wege und Rückblicke zusammen</span></div><i>→</i></button><button onclick="go('today')"><div><b>Offene Rückblicke</b><span>${gaps.length?gaps.length+" Erinnerungslücken":"Aktuell nichts offen"}</span></div><i>→</i></button><button onclick="$('#importFile').click()"><div><b>Backup importieren</b><span>Vorhandene lokale Daten wiederherstellen</span></div><i>→</i></button><button onclick="exportData()"><div><b>Backup exportieren</b><span>Deine privaten Daten als JSON sichern</span></div><i>→</i></button></div><input id="importFile" type="file" accept=".json" hidden onchange="importData(this.files[0])"><section class="legal-note"><b>Offline & privat</b><p>Persönliche Inhalte bleiben in dieser Version lokal auf deinem Gerät. OTB Deutsch und Luther 1912 sind offline enthalten.</p></section><section class="legal-note"><b>FaithPath</b><p>FaithPath misst nicht deinen Glauben. Es hilft dir, deine Entwicklung über Zeit zu erkennen.</p><small>${BUILD}</small></section></main>`)}
function exportData(){let blob=new Blob([JSON.stringify({app:"FaithPath",version:4,exported:new Date().toISOString(),data:normalizeState(S),guidedPlans:planProgress()},null,2)],{type:"application/json"}),a=document.createElement("a"),url=URL.createObjectURL(blob);a.href=url;a.download=`faithpath-backup-${new Date().toISOString().slice(0,10)}.json`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500)}
async function importData(f){if(!f)return;try{if(f.size>10*1024*1024)throw new Error("too large");let x=JSON.parse(await f.text());if(!x||typeof x!=="object"||Array.isArray(x))throw new Error("invalid");if(x.app&&x.app!=="FaithPath")throw new Error("wrong app");let d=x.data||x,next=validateKnownState(normalizeState(d,true)),plans=x.guidedPlans==null?null:normalizePlanProgress(x.guidedPlans,true);S=next;if(plans)localStorage.setItem("faithpath.guidedPlans.v1",JSON.stringify(plans));save();UI.pending=null;UI.readerBack=null;UI.readerTranslation=null;UI.path=null;UI.story=null;UI.qi=0;UI.answered=null;UI.selected.clear();UI.journalFilter="Alle";UI.historyLimit=120;UI.bibleTab="stories";toast("Backup importiert");renderMore()}catch{toast("Backup ist ungültig oder beschädigt")}finally{let input=$("#importFile");if(input)input.value=""}}
function openSheet(content){closeSheet();let d=document.createElement("div");d.id="sheetback";d.className="sheetback";d.innerHTML=`<div class="sheet"><div class="handle"></div>${content}</div>`;d.addEventListener("click",e=>{if(e.target===d)closeSheet()});document.body.appendChild(d)}
function closeSheet(){document.getElementById("sheetback")?.remove()}
const ONBOARD_KEY="faithpath.onboarding.v4";
let onboardingStep=0,onboardingTimer=null;
function onboardingMarkup(){return `<div class="onboarding" id="onboarding"><button class="onboarding-skip" onclick="skipOnboarding()">Überspringen</button><div class="onboarding-stage"><section class="onboarding-screen active" data-step="0"><div class="onboarding-visual"><img src="trees/tree-stage-2.webp" alt="Junger Olivenbaum"></div><div class="eyebrow">FAITHPATH</div><h1>Du musst nicht wissen, wo du anfangen sollst.</h1><p>Starte mit einer Situation, die dich beschäftigt – oder gehe direkt in die Bibel.</p></section><section class="onboarding-screen" data-step="1"><div class="onboarding-flow"><b>Situation / Bibel</b><span>→</span><b>Reflexion</b><span>→</span><b>Mein Weg</b></div><div class="eyebrow">DEIN WEG</div><h1>Aus einem Gedanken kann ein persönlicher Weg werden.</h1><p>FaithPath hilft dir, Bibelstellen, Gedanken und kleine Schritte miteinander zu verbinden.</p></section><section class="onboarding-screen" data-step="2"><div class="onboarding-growth">${[1,2,3,4,5,6,7].map((n,i)=>`<img src="trees/tree-stage-${n}.webp" alt="" data-tree="${i}">`).join("")}</div><div class="eyebrow">SPÄTER</div><h1>Was ist daraus geworden?</h1><p>FaithPath bringt frühere Gedanken ruhig zurück und macht deine persönliche Glaubensgeschichte sichtbar.</p><div class="onboarding-note">FaithPath misst nicht deinen Glauben.</div></section></div><div class="onboarding-footer"><div class="onboarding-dots">${[0,1,2].map(i=>`<i class="onboarding-dot ${i===0?"active":""}"></i>`).join("")}</div><button class="onboarding-next" onclick="nextOnboarding()">Weiter</button></div></div>`}
function skipOnboarding(){localStorage.setItem(ONBOARD_KEY,"done");clearInterval(onboardingTimer);document.getElementById("onboarding")?.remove();document.body.classList.remove("onboarding-open")}
function showOnboarding(){onboardingStep=0;document.body.classList.add("onboarding-open");document.body.insertAdjacentHTML("beforeend",onboardingMarkup());}
function animateGrowth(){clearInterval(onboardingTimer);let imgs=[...document.querySelectorAll(".onboarding-growth img")],i=0;if(!imgs.length)return;imgs.forEach(x=>x.classList.remove("show"));imgs[0].classList.add("show");onboardingTimer=setInterval(()=>{imgs[i].classList.remove("show");i=(i+1)%imgs.length;imgs[i].classList.add("show")},1050)}
function nextOnboarding(){if(onboardingStep===2){localStorage.setItem(ONBOARD_KEY,"done");clearInterval(onboardingTimer);document.getElementById("onboarding")?.remove();document.body.classList.remove("onboarding-open");return}let old=document.querySelector(`.onboarding-screen[data-step="${onboardingStep}"]`);old?.classList.add("leaving");old?.classList.remove("active");onboardingStep++;let next=document.querySelector(`.onboarding-screen[data-step="${onboardingStep}"]`);next?.classList.add("active");document.querySelectorAll(".onboarding-dot").forEach((d,i)=>d.classList.toggle("active",i===onboardingStep));let btn=document.querySelector(".onboarding-next");if(btn)btn.textContent=onboardingStep===2?"FaithPath beginnen":"Weiter";if(onboardingStep===2)animateGrowth();else clearInterval(onboardingTimer)}
init().then(()=>{if(!localStorage.getItem(ONBOARD_KEY))showOnboarding()}).catch(e=>{$("#app").innerHTML=`<div class="card"><h2>FaithPath konnte nicht starten.</h2><p>${esc(e.message)}</p></div>`});
