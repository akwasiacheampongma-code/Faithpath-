{
  "name": "faithpath",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:at-rounds:test": "node scripts/build-at-rounds-test.mjs",
    "validate:at-rounds:test": "node scripts/validate-at-rounds-test.mjs",
    "test:at-rounds:browser": "node tests/at-rounds-browser.mjs",
    "test:at-rounds:acceptance": "node tests/at-rounds-acceptance.mjs",
    "test:at-rounds:update": "node tests/at-rounds-offline-update.mjs",
    "validate:at-rounds:reachability": "node scripts/validate-at-rounds-reachability.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-content.mjs",
    "serve": "node scripts/serve.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:update": "npm run build && node tests/service-worker.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
