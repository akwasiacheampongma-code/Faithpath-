{
  "name": "faithpath",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-content.mjs",
    "serve": "node scripts/serve.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:update": "npm run build && node tests/service-worker.mjs",
    "import:nt-quiz": "python3 scripts/import-nt-quiz.py",
    "validate:nt-quiz": "python3 scripts/import-nt-quiz.py --check && node scripts/validate-nt-quiz.mjs",
    "test:nt-quiz:browser": "node tests/nt-quiz-browser.mjs",
    "test:nt-quiz:update": "node tests/quiz-final-update.mjs",
    "validate:nachlese-mc": "node scripts/validate-nachlese-mc.mjs",
    "validate:nachlese-editorial": "python3 scripts/validate-nachlese-editorial-source.py --check && node scripts/validate-nachlese-mc.mjs",
    "test:nachlese-editorial:browser": "node tests/nachlese-editorial-browser.mjs",
    "test:nachlese-editorial:update": "node tests/nachlese-editorial-update.mjs",
    "test:nachlese-mc:browser": "node tests/nachlese-mc-corpus-browser.mjs",
    "test:nachlese-mc:fixtures": "node tests/nachlese-mc-browser.mjs",
    "test:nachlese-mc:update": "node tests/nachlese-mc-update.mjs",
    "pretest": "npm run validate",
    "lint": "eslint src scripts tests/*.test.mjs eslint.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "eslint": "10.13.0",
    "playwright": "^1.62.1"
  }
}
