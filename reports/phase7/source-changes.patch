+/** Compare source authorities with the exact accepted base, never with a moving branch. */
+import fs from 'node:fs';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {execFileSync} from 'node:child_process';
+import {KEYS,empty} from '../src/store.js';
+const base='7d24aea30bec5b0b8d43e199f3cadfc6305c1e3e';
+const git=(...args)=>execFileSync('git',args,{maxBuffer:64*1024*1024});
+const hash=v=>crypto.createHash('sha256').update(v).digest('hex');
+const authorities=['src/store.js','src/drafts.js','src/journal-storage.js','src/import-validation.js','src/backup-model.js','src/domain.js','src/tree-view.js','src/tree-stage-guide.js','src/bible-journey.js','scripts/sw-template.js','styles.css'];
+const names=git('ls-tree','-r','--name-only',base).toString().trim().split('\n');
+const protectedFiles=names.filter(name=>name.startsWith('data/')||name.startsWith('trees/')||name.startsWith('src/verbunden/')||name.endsWith('.css')||authorities.includes(name));
+for(const file of protectedFiles)assert.equal(hash(fs.readFileSync(file)),hash(git('show',base+':'+file)),file+' changed protected authority/content');
+assert.equal(empty().version,5);
+assert.deepEqual(KEYS,{main:'faithpath.v1.rebuild',plans:'faithpath.guidedPlans.v1',onboard:'faithpath.onboarding.v4',legacyOnboard:'faithpath.onboarding.v3',migration:'faithpath.backup.pre-v5',restore:'faithpath.backup.before-import',draft:'faithpath.draft.v4'});
+console.log(JSON.stringify({status:'PASS',base,protectedFiles:protectedFiles.length,schema:5,keys:KEYS,allContentAndStylesUnchanged:true},null,2));
diff --git a/scripts/check-modules.mjs b/scripts/check-modules.mjs
new file mode 100644
index 0000000..9a5bb68
--- /dev/null
+++ b/scripts/check-modules.mjs
@@ -0,0 +1,15 @@
+/** Resolve runtime ESM edges from ESLint's parser, rather than guessing with regex. */
+import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {Linter} from 'eslint';
+const list=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?list(path.join(dir,e.name)):[path.join(dir,e.name)]).filter(f=>f.endsWith('.js')).sort();
+const graph={},linter=new Linter();
+for(const file of list('src')) {
+ const edges=[];
+ const rule={create:()=>({ImportDeclaration:node=>edges.push(node.source.value),ExportNamedDeclaration:node=>{if(node.source)edges.push(node.source.value)},ExportAllDeclaration:node=>edges.push(node.source.value)})};
+ const diagnostics=linter.verify(fs.readFileSync(file,'utf8'),[{plugins:{graph:{rules:{edges:rule}}},rules:{'graph/edges':'error'}}]);
+ assert(!diagnostics.some(d=>d.fatal),file+' has invalid JavaScript');
+ graph[file]=edges.map(edge=>{assert(edge.startsWith('.'),file+': no unbundled runtime dependencies');const target=path.normalize(path.join(path.dirname(file),edge));assert(fs.existsSync(target),file+' imports missing '+target);return target});
+}
+const visiting=new Set(),done=new Set();
+function visit(file,chain=[]){assert(!visiting.has(file),'Runtime import cycle: '+[...chain,file].join(' -> '));if(done.has(file))return;visiting.add(file);for(const next of graph[file]||[])visit(next,[...chain,file]);visiting.delete(file);done.add(file)}
+for(const file of Object.keys(graph))visit(file);
+console.log(JSON.stringify({status:'PASS',modules:Object.keys(graph).length,edges:Object.values(graph).reduce((n,x)=>n+x.length,0),cycles:0,graph},null,2));
